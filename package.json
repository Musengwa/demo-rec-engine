    "jwks-rsa": "^3.1.0",
    "lru-cache": "^10.4.3",
    "node-cron": "^3.0.3",
    "pino-pretty": "^11.2.2"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.15",
    "@types/node-cron": "^3.0.11",
